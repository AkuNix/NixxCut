# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=nixxcut
pkgver=${NIXXCUT_VERSION:?NIXXCUT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/AkuNix/NixxCut"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${NIXXCUT_STAGE:?NIXXCUT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/nixxcut" "$pkgdir/opt/nixxcut/nixxcut"
  install -d "$pkgdir/opt/nixxcut/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/nixxcut/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/nixxcut/nixxcut "$@"\n' > "$pkgdir/usr/bin/nixxcut"
  chmod 755 "$pkgdir/usr/bin/nixxcut"
  install -Dm644 "$stage/nixxcut.desktop" "$pkgdir/usr/share/applications/nixxcut.desktop"
  sed -i 's|^Exec=nixxcut|Exec=/opt/nixxcut/nixxcut %U|' "$pkgdir/usr/share/applications/nixxcut.desktop"
  install -Dm644 "$stage/nixxcut.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/nixxcut.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/nixxcut/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/nixxcut/THIRD_PARTY_NOTICES.md"
}
